# Example environment for local development. Copy to `.env` and fill in.
# `.env` is git-ignored — never commit real secrets. Variable names below are
# the ones the applications actually consume.

# --- MCP BoondManager server (Java / Spring) --------------------------------
# Base URL of the BoondManager API (note the trailing slash).
BOONDMANAGER_BASE_URL=https://ui.boondmanager.com/api/
# JWT client token used to authenticate against BoondManager (required).
BOONDMANAGER_JWT_CLIENT=replace-me
# Optional tuning (defaults shown):
# BOONDMANAGER_TIMEOUT=15s
# BOONDMANAGER_MAX_IN_MEMORY_SIZE=16MB

# --- Agent API (Python / FastAPI) -------------------------------------------
# Environment. Anything other than local/dev/development/test/testing/ci
# REQUIRES ENABLE_AUTH=true (the API fails fast at startup otherwise).
APP_ENV=local
# Server-side Microsoft Entra ID bearer-token validation. Keep false locally;
# production must set it true (with the two ids below).
ENABLE_AUTH=false
# ENTRA_TENANT_ID=replace-me
# ENTRA_CLIENT_ID=replace-me
# Restrict accepted accounts to one email domain (empty disables the check).
AUTH_ALLOWED_EMAIL_DOMAIN=sijo.fr
# URL of the MCP server (defaults to http://localhost:8001/mcp).
# MCP_SERVER_URL=http://localhost:8001/mcp
# Use the in-process mock MCP client instead of a live MCP server.
USE_MOCK_MCP=true

# --- LLM provider (Agent API) -----------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-me
# USE_LLM_PLANNER=false

# --- Local service ports ----------------------------------------------------
WEB_UI_PORT=5500
AGENT_API_PORT=8000
MCP_BOONDMANAGER_PORT=8001
