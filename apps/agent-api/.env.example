# When true, the Agent API uses an in-memory MockMcpClient for local
# development and tests. When false, it connects to a real MCP server via
# RemoteMcpClient using the configured transport.
USE_MOCK_MCP=true

APP_ENV=local
LOG_LEVEL=INFO

# Full MCP endpoint URL exposed by the remote MCP server.
MCP_SERVER_URL=http://localhost:8001/mcp

# Transport used by RemoteMcpClient. Only `streamable_http` is supported today.
MCP_TRANSPORT=streamable_http

MCP_TIMEOUT_SECONDS=15
MCP_MAX_RETRIES=2
MAX_REPLAN_ATTEMPTS=1

# --- MCP result caching (ADR-013) ---------------------------------------
# In-process TTL cache for semi-stable MCP results: the reference
# dictionary, CV text, technical documents, and the tool catalogue.
# Volatile data (search results, candidate detail, administrative/salary)
# is never cached. Set MCP_CACHE_ENABLED=false to bypass entirely.
MCP_CACHE_ENABLED=true
MCP_DICTIONARY_CACHE_TTL_SECONDS=21600
MCP_CANDIDATE_DOC_CACHE_TTL_SECONDS=21600
MCP_TOOLS_CACHE_TTL_SECONDS=300
MCP_CACHE_MAX_ENTRIES=512

# --- LLM planner --------------------------------------------------------
# When false (default) the deterministic fallback planner runs. When true,
# the Agent API uses the configured LLM to interpret queries and plan
# bounded MCP tool calls; startup fails fast if LLM_API_KEY is missing or
# the SDK for LLM_PROVIDER is not installed.
USE_LLM_PLANNER=false

# Supported providers: "anthropic", "openai".
LLM_PROVIDER=openai

# Model identifier passed to the configured provider's SDK.
# Examples: "claude-sonnet-4-6" (anthropic), "gpt-5.2" (openai).
LLM_MODEL=gpt-5.4

# Provider API key. Generic name — set the key for whichever provider
# LLM_PROVIDER points at.
LLM_API_KEY=

# Sampling temperature. Default 0 for deterministic planning.
LLM_TEMPERATURE=0.0

# Maximum time to wait for one LLM planner response.
LLM_TIMEOUT_SECONDS=60

# Hard cap on planned tool calls per query.
LLM_MAX_PLAN_STEPS=6

# --- Microsoft Entra ID SSO ---------------------------------------------
# When true, every /api/* route except /api/health and /api/ready requires
# a valid Entra ID access token (Authorization: Bearer). Startup fails fast
# if the tenant/client ids below are missing.
ENABLE_AUTH=false

# Directory (tenant) ID and Application (client) ID of the app
# registration (Azure portal > Entra ID > App registrations).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Accounts must sign in with an address ending in @<this domain>.
# A single-tenant registration already restricts sign-in to the tenant;
# this additionally rejects invited guest accounts. Empty disables it.
AUTH_ALLOWED_EMAIL_DOMAIN=sijo.fr

# --- CORS ---------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# Add the deployed web-ui origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- CV semantic retrieval / RAG (ADR-014) ------------------------------
# When true, a vector index over candidate CVs runs as a SECOND recall
# channel alongside searchCandidates: semantically similar candidates the
# keyword search missed are added to the pool, then ranked normally.
# Populate the index first: uv run python scripts/index_candidates.py
ENABLE_CV_RAG=false

# Vector index backend: sqlite (dev) or azure_table (production; reuses
# the AZURE_STORAGE_* credentials below).
RAG_STORE=sqlite
RAG_SQLITE_PATH=data/cv_index.db

# Embedding model + Matryoshka dimensionality. 512 dims ~= 53 MB in RAM
# for 26k candidates. Changing dims invalidates the index (re-run the
# indexing script with --force).
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMS=512
# Falls back to OPENAI_API_KEY when unset.
RAG_EMBEDDING_API_KEY=

# Max candidates the vector channel may ADD per search, and the cosine
# floor below which a hit is considered noise (measured on the live
# base: related profiles ~0.5+, barely related ~0.4).
RAG_TOP_K=10
RAG_MIN_SCORE=0.45

# Index candidates seen during searches but missing from the index
# (embeddings only — reuses the payloads enrichment just downloaded).
RAG_CATCH_UP_ENABLED=true

# Parallel candidates fetched by the bulk indexing script (each costs
# 2 MCP calls and a PDF extraction server-side).
RAG_INDEX_CONCURRENCY=6

# --- Conversation persistence -------------------------------------------
# Backend for per-user conversation history.
#   sqlite      : local file (dev/tests). Path below, created on startup.
#   azure_table : Azure Table Storage (production). Needs either the
#                 connection string, or the account URL + managed identity
#                 with the "Storage Table Data Contributor" role.
CONVERSATION_STORE=sqlite
SQLITE_DB_PATH=data/conversations.db
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=

# --- External candidate discovery (LinkedIn via OpenAI Web Search) -------
# Master switch. When false, the LinkedIn source never runs and "no source
# selected" resolves to BoondManager only. When true, "no source selected"
# resolves to BoondManager + LinkedIn.
EXTERNAL_SEARCH_ENABLED=false
# Only 'openai_web' (OpenAI Responses API web_search) is implemented.
EXTERNAL_SEARCH_PROVIDER=openai_web
# Model used for web search — MUST support the built-in web_search tool.
EXTERNAL_SEARCH_MODEL=gpt-5.4
# Bounded search ladder: max complementary web-search queries per discovery.
EXTERNAL_SEARCH_MAX_QUERIES=6
# Max external profiles returned per search (after dedup).
EXTERNAL_SEARCH_MAX_RESULTS=20
# Restrict discovery to public linkedin.com/in profile pages.
EXTERNAL_SEARCH_LINKEDIN_ONLY=true
# TTL for the in-process external web-search cache (default 6h). 0 disables.
EXTERNAL_SEARCH_CACHE_TTL_SECONDS=21600
# API key for the web-search provider. Falls back to OPENAI_API_KEY when unset.
EXTERNAL_SEARCH_API_KEY=

# --- SIJO external candidate qualification defaults ----------------------
# Prefer consultant/freelance profiles (applied automatically by the planner).
CANDIDATE_PREFER_CONSULTING_PROFILE=true
# Minimum client-mission length (months) that counts as a "long mission".
# Never hardcoded in code — this is the single source of truth.
CANDIDATE_LONG_MISSION_THRESHOLD_MONTHS=24

# Hard filter: exclude clearly-foreign external profiles that evidence
# neither French nor an experience in France (unknown location never excluded).
CANDIDATE_REQUIRE_FRENCH_OR_FRANCE_EXPERIENCE=true
