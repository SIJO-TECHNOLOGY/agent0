# When true, the Agent API uses an in-memory MockMcpClient for local
# development and tests. When false, it connects to a real MCP server via
# RemoteMcpClient using the configured transport.
USE_MOCK_MCP=true

APP_ENV=local
LOG_LEVEL=INFO

# Full MCP endpoint URL exposed by the remote MCP server.
MCP_SERVER_URL=http://localhost:8001/mcp

# Transport used by RemoteMcpClient. Only `streamable_http` is supported today.
MCP_TRANSPORT=streamable_http

MCP_TIMEOUT_SECONDS=15
MCP_MAX_RETRIES=2
MAX_REPLAN_ATTEMPTS=1

# --- LLM planner --------------------------------------------------------
# When false (default) the deterministic fallback planner runs. When true,
# the Agent API uses the configured LLM to interpret queries and plan
# bounded MCP tool calls; startup fails fast if LLM_API_KEY is missing or
# the SDK for LLM_PROVIDER is not installed.
USE_LLM_PLANNER=false

# Supported providers: "anthropic", "openai".
LLM_PROVIDER=openai

# Model identifier passed to the configured provider's SDK.
# Examples: "claude-sonnet-4-6" (anthropic), "gpt-5.2" (openai).
LLM_MODEL=gpt-5.4

# Provider API key. Generic name — set the key for whichever provider
# LLM_PROVIDER points at.
LLM_API_KEY=

# Sampling temperature. Default 0 for deterministic planning.
LLM_TEMPERATURE=0.0

# Maximum time to wait for one LLM planner response.
LLM_TIMEOUT_SECONDS=60

# Hard cap on planned tool calls per query.
LLM_MAX_PLAN_STEPS=6

# --- Microsoft Entra ID SSO ---------------------------------------------
# When true, every /api/* route except /api/health and /api/ready requires
# a valid Entra ID access token (Authorization: Bearer). Startup fails fast
# if the tenant/client ids below are missing.
ENABLE_AUTH=false

# Directory (tenant) ID and Application (client) ID of the app
# registration (Azure portal > Entra ID > App registrations).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Accounts must sign in with an address ending in @<this domain>.
# A single-tenant registration already restricts sign-in to the tenant;
# this additionally rejects invited guest accounts. Empty disables it.
AUTH_ALLOWED_EMAIL_DOMAIN=sijo.fr
